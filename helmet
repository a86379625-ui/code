from ultralytics import YOLO
import cv2
import pyttsx3
import threading

# Load YOLO model
model = YOLO("best.pt")

# Setup TTS engine
engine = pyttsx3.init()
engine.setProperty("rate", 150)
engine.setProperty("volume", 1.0)

# Global flag for alert
alert_active = False

def voice_alert():
    """Background thread that keeps speaking until helmet is detected."""
    global alert_active
    while alert_active:
        engine.say("Please wear helmet")
        engine.runAndWait()

cap = cv2.VideoCapture(0)  # webcam

while True:
    ret, frame = cap.read()
    if not ret:
        break

    results = model(frame, stream=True)

    no_helmet_detected = False

    for r in results:
        for box in r.boxes:
            cls_id = int(box.cls[0])
            conf = float(box.conf[0])
            x1, y1, x2, y2 = map(int, box.xyxy[0])
            label = model.names[cls_id]

            # Draw bounding boxes
            color = (0, 255, 0) if label == "helmet" else (0, 0, 255)
            cv2.rectangle(frame, (x1, y1), (x2, y2), color, 2)
            cv2.putText(frame, f"{label} {conf:.2f}",
                        (x1, y1 - 10), cv2.FONT_HERSHEY_SIMPLEX,
                        0.8, color, 2)

            # Check for "head" (no helmet)
            if label.lower() in ["head", "no_helmet"] and conf > 0.7:
                no_helmet_detected = True

    # Start alert if no helmet
    if no_helmet_detected and not alert_active:
        alert_active = True
        threading.Thread(target=voice_alert, daemon=True).start()

    # Stop alert if helmet detected
    if not no_helmet_detected and alert_active:
        alert_active = False

    cv2.imshow("Helmet Detection", frame)

    if cv2.waitKey(1) & 0xFF == ord("q"):
        break

cap.release()
cv2.destroyAllWindows()
