from ultralytics import YOLO
import cv2
import pyttsx3
import time

# Load YOLO model
model = YOLO(r"C:\Users\ININGEM\runs\detect\train\weights\best.pt")

# Setup TTS engine
engine = pyttsx3.init()
engine.setProperty("rate", 150)
engine.setProperty("volume", 1.0)

last_alert_time = 0
cooldown = 3  # seconds

cap = cv2.VideoCapture(0)  # webcam (use path to .mp4 if video file)

while True:
    ret, frame = cap.read()
    if not ret:
        break

    results = model(frame, stream=True)

    no_helmet_detected = False

    for r in results:
        for box in r.boxes:
            cls_id = int(box.cls[0])
            conf = float(box.conf[0])
            x1, y1, x2, y2 = map(int, box.xyxy[0])
            label = model.names[cls_id]

            # Map label: show "Head" instead of "no_helmet"
            if label == "no_helmet":
                display_label = "Head"
                color = (0, 0, 255)  # Red for warning
                no_helmet_detected = True
            else:
                display_label = "Helmet"
                color = (0, 255, 0)  # Green for safe

            # Draw detections
            cv2.rectangle(frame, (x1, y1), (x2, y2), color, 2)
            cv2.putText(frame, f"{display_label} {conf:.2f}",
                        (x1, y1 - 10), cv2.FONT_HERSHEY_SIMPLEX,
                        0.8, color, 2)

    # 🔊 Voice alert only once per cooldown
    if no_helmet_detected and (time.time() - last_alert_time > cooldown):
        engine.say("Please wear helmet")
        engine.runAndWait()
        last_alert_time = time.time()

    cv2.imshow("Helmet Detection", frame)

    if cv2.waitKey(1) & 0xFF == ord("q"):
        break

cap.release()
cv2.destroyAllWindows()
