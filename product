import cv2
import numpy as np
from skimage.metrics import structural_similarity as ssim

def check_completion(reference_path, test_path):
    # Load images
    ref_img = cv2.imread(reference_path)
    test_img = cv2.imread(test_path)

    if ref_img is None or test_img is None:
        print("Error: Could not load one of the images.")
        return

    # Resize to same size
    ref_img = cv2.resize(ref_img, (400, 600))
    test_img = cv2.resize(test_img, (400, 600))

    # Convert to grayscale
    ref_gray = cv2.cvtColor(ref_img, cv2.COLOR_BGR2GRAY)
    test_gray = cv2.cvtColor(test_img, cv2.COLOR_BGR2GRAY)

    # --- Step 1: Check if tray is empty ---
    edges = cv2.Canny(test_gray, 50, 150)
    edge_pixels = np.sum(edges > 0)

    if edge_pixels < 5000:  # tune threshold
        status = "Empty Tray ⬜"
        cv2.putText(test_img, status, (30, 50), cv2.FONT_HERSHEY_SIMPLEX,
                    1.0, (255, 0, 0), 3)
        combined = np.hstack((ref_img, test_img, cv2.cvtColor(edges, cv2.COLOR_GRAY2BGR)))
        cv2.imshow("Reference | Test with Boxes | Raw Difference", combined)
        cv2.waitKey(0)
        cv2.destroyAllWindows()
        return status

    # --- Step 2: Compare with reference ---
    score, diff = ssim(ref_gray, test_gray, full=True)
    diff = (diff * 255).astype("uint8")

    print(f"Similarity Score: {score:.4f}")

    # Threshold and find contours of differences
    thresh = cv2.threshold(diff, 200, 255, cv2.THRESH_BINARY_INV)[1]
    contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    # Draw differences on test image
    for c in contours:
        if cv2.contourArea(c) > 200:  # ignore tiny noise
            (x, y, w, h) = cv2.boundingRect(c)
            cv2.rectangle(test_img, (x, y), (x + w, y + h), (0, 0, 255), 2)

    # Status text
    if score > 0.90:
        status = "Completed ✅"
        color = (0, 255, 0)
    else:
        status = "Incomplete ❌"
        color = (0, 0, 255)

    cv2.putText(test_img, status, (30, 50), cv2.FONT_HERSHEY_SIMPLEX,
                1.0, color, 3)

    # Combine all three views side by side
    diff_bgr = cv2.cvtColor(diff, cv2.COLOR_GRAY2BGR)
    combined = np.hstack((ref_img, test_img, diff_bgr))

    # Show one single window
    cv2.imshow("Reference | Test with Boxes | Raw Difference", combined)
    cv2.waitKey(0)
    cv2.destroyAllWindows()

    return status


# Example usage
reference_image = "2.jpg"  # final product
test_image = "1.jpg"       # current assembly / empty tray
result = check_completion(reference_image, test_image)
print("Result:", result)
