import cv2
import numpy as np

# Reference image (completed product)
reference_path = "2.jpg"
ref_img = cv2.imread(reference_path)
if ref_img is None:
    print("Error: Could not load reference image.")
    exit()

# Resize reference image for consistency
ref_img = cv2.resize(ref_img, (400, 400))

# RTSP Camera Stream
rtsp_url = "rtsp://username:password@192.168.1.100:554/Streaming/Channels/101"
cap = cv2.VideoCapture(rtsp_url)

if not cap.isOpened():
    print("Error: Could not connect to camera.")
    exit()

while True:
    ret, frame = cap.read()
    if not ret:
        print("Failed to grab frame.")
        break

    # Resize live frame
    test_img = cv2.resize(frame, (400, 400))

    # Convert to grayscale
    gray_ref = cv2.cvtColor(ref_img, cv2.COLOR_BGR2GRAY)
    gray_test = cv2.cvtColor(test_img, cv2.COLOR_BGR2GRAY)

    # Absolute difference
    diff = cv2.absdiff(gray_ref, gray_test)

    # Threshold to highlight differences
    _, thresh = cv2.threshold(diff, 50, 255, cv2.THRESH_BINARY)

    # Count non-zero differences
    non_zero_count = cv2.countNonZero(thresh)

    # Decide result
    if non_zero_count > 5000:  # adjust sensitivity
        result_text = "Result: Incomplete ❌"
        color = (0, 0, 255)  # Red
    else:
        result_text = "Result: Complete ✅"
        color = (0, 255, 0)  # Green

    # Stack images for display
    diff_bgr = cv2.cvtColor(thresh, cv2.COLOR_GRAY2BGR)
    combined = np.hstack((ref_img, test_img, diff_bgr))

    # Add result text
    cv2.putText(combined, result_text, (50, 50),
                cv2.FONT_HERSHEY_SIMPLEX, 1.2, color, 3)

    # Show output
    cv2.imshow("Product Verification", combined)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
